<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Finder Sync extension (FinderSync.swift). macOS only loads app extensions that are
     sandboxed; it reads nothing itself, only hands the selected URLs to Midna.app. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key><true/>
</dict>
</plist>
