---
import { Image } from 'astro:assets';
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import main from '../assets/screens/main.png';
import approveMenu from '../assets/screens/approve-menu.png';
import rules from '../assets/screens/rules.png';
import triggers from '../assets/screens/triggers.png';
import commandBar from '../assets/screens/command-bar.png';
import { DOWNLOAD } from '../site';

const title = 'midna: a macOS terminal for Claude Code and Codex';
const description =
  'midna is a native macOS terminal for working with AI agents. Agents can open and read terminals through a CLI and MCP server, approvals from every terminal land in one queue, and your shells keep running when the app restarts.';

const sections = [
  {
    id: 'approvals',
    title: 'Approvals from every terminal in one place',
    body: [
      'When Claude Code or Codex shows a permission prompt, or a rule says to ask, the terminal is marked in the sidebar and the request shows along the bottom of it. ⌘↩ approves, ⌘⌫ denies, and ⌘J steps through everything that’s waiting across all projects.',
      'Approving for 15 minutes, an hour, the session or always adds a rule, so you aren’t asked about the same thing again.',
    ],
    image: approveMenu,
    alt: 'An approval at the bottom of a Codex terminal with the menu open: approve once, for 15 minutes, for 1 hour, for this session, or always',
    href: '/docs/agents/',
  },
  {
    id: 'rules',
    title: 'Rules for what agents can run',
    body: [
      'Allow, ask or deny tool calls, commands and paths, globally, per project or per terminal. Claude Code checks every tool call against them through the hooks midna starts it with.',
      'Agents can add rules. Removing one is up to you: an agent can only ask, and the request waits in Needs you.',
    ],
    image: rules,
    alt: 'The Rules screen: global, project and terminal columns, a test field, and a feed of recent decisions',
    href: '/docs/rules/',
  },
  {
    id: 'triggers',
    title: 'Triggers',
    body: [
      'Start an agent when a pull request opens on GitHub or Bitbucket, with webhooks delivered to your Mac over Tailscale Funnel. Or react to local events: a blocked prompt, an idle terminal, a schedule.',
      'Agents can draft webhook triggers. You paste the signing secret and switch them on.',
    ],
    image: triggers,
    alt: 'The Triggers screen with three local triggers and the details of one that sets a custom status',
    href: '/docs/triggers/',
  },
  {
    id: 'command-bar',
    title: 'Everything from ⌘K',
    body: [
      'Jump to a terminal, answer what’s waiting, run a project’s saved commands, or open Rules, Triggers and Settings. Type a sentence and press ⇧↩ to start an agent with it as the first prompt.',
    ],
    image: commandBar,
    alt: 'The command bar listing waiting items, terminals and suggestions to ask an agent',
    href: '/docs/terminals/#the-command-bar',
  },
];

const details = [
  {
    title: 'Shells survive restarts',
    body: 'A daemon, midnad, owns every terminal. Quit the app, update it or restart the daemon and your shells keep running with their screens and scrollback.',
  },
  {
    title: 'Agent status you can trust',
    body: 'Working, needs you, done or failed comes from the agents’ hooks, the terminal title and exit codes, not guesses. The header shows the branch, the diff and the pull request’s checks.',
  },
  {
    title: 'Terminal basics',
    body: 'Splits, pop-out windows, find in scrollback, ⌘-click for URLs and file:line paths, rectangular selection, Mac text editing keys.',
  },
  {
    title: 'Built for long agent sessions',
    body: 'Jump back to earlier prompts, queue follow-up messages until the agent is free, attach annotated screenshots, and see the links and files a session touched.',
  },
  {
    title: 'Themes',
    body: 'Eight built-in themes, light and dark, that follow macOS. Custom themes are JSON files that can extend a built-in one.',
  },
  {
    title: 'Native',
    body: 'Written in Rust with GPUI for the window and libghostty for the terminal engine. Signed, notarized, and updates itself.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://midna.mrgnhnt.com/icon.png" />
    <meta name="theme-color" content="#0f1117" />
  </head>
  <body>
    <Nav />

    <main>
      <section class="hero">
        <div class="wrap">
          <h1>A macOS terminal for working with Claude Code and Codex</h1>
          <p class="lede">
            Agents can open terminals, run commands you can watch and read each other’s output through the <code
              >midna</code
            > CLI or its MCP server. Anything that needs your answer waits in one queue, and your shells
            keep running when the app restarts or updates.
          </p>
          <div class="ctas">
            <a class="btn btn-accent" href={DOWNLOAD}>Download for Mac</a>
            <a class="btn btn-ghost" href="/docs/">Documentation</a>
          </div>
          <p class="fineprint">Free and open source (MIT) · Apple Silicon · macOS 12 or later</p>
        </div>
        <div class="wrap shot-wrap">
          <figure class="shot hero-shot">
            <Image
              src={main}
              alt="The midna window: projects and terminals in the sidebar with their status, a Codex terminal asking to run a migration, and the approval along the bottom"
              widths={[1280, 1920, 2560]}
              sizes="(max-width: 1200px) 100vw, 1160px"
              loading="eager"
            />
          </figure>
        </div>
      </section>

      {
        sections.map((s) => (
          <section id={s.id} class="feature">
            <div class="wrap">
              <div class="feature-head">
                <h2>{s.title}</h2>
                <div class="feature-text">
                  {s.body.map((p) => (
                    <p>{p}</p>
                  ))}
                  <a class="more" href={s.href}>
                    Read more →
                  </a>
                </div>
              </div>
              <figure class="shot feature-shot">
                <Image src={s.image} alt={s.alt} widths={[1280, 1920, 2560]} sizes="(max-width: 1200px) 100vw, 1112px" />
              </figure>
            </div>
          </section>
        ))
      }

      <section id="cli" class="feature">
        <div class="wrap feature-grid">
          <div class="feature-copy">
            <h2>A CLI and MCP server for agents</h2>
            <p>
              Everything the app does is a method on the daemon. Agents call them with the <code>midna</code> command or <code
                >midna mcp</code
              >, which midna adds to the Claude Code and Codex sessions it starts.
            </p>
            <p>
              When an agent asks for something only you can do, the call becomes a request in Needs you and the response
              says so, so the agent knows to wait.
            </p>
            <a class="more" href="/docs/cli/">Read more →</a>
          </div>
          <pre class="shell" aria-label="An agent using the midna CLI"><span class="dim">$</span> midna open --name tests --monitor 'cargo test'
<span class="dim">$</span> midna read a1f00003 --lines 20
<span class="dim">$</span> midna rules add deny command 'git push --force*'
<span class="dim">$</span> midna rules remove r_41
<span class="need">rule.remove is human only; use rule.request_removal
to ask the human</span>
<span class="dim">$</span> midna rules request-removal r_41 --reason "blocks the release tag"
<span class="dim">$</span> midna attention "tests pass, ready for review"</pre>
        </div>
      </section>

      <section class="details">
        <div class="wrap">
          <h2>Also</h2>
          <div class="detail-grid">
            {
              details.map((d) => (
                <div class="detail">
                  <h3>{d.title}</h3>
                  <p>{d.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="install">
        <div class="wrap install-grid">
          <div>
            <h2>Install</h2>
            <ol>
              <li><a href={DOWNLOAD}>Download the DMG</a> and drag Midna into Applications.</li>
              <li>Open it. midna installs its daemon as a login item and links the <code>midna</code> CLI into <code>~/.local/bin</code>.</li>
              <li>Open a folder with ⌘O, or start an agent with ⇧⌘T.</li>
            </ol>
            <p class="fineprint">
              Needs a Mac with Apple Silicon and macOS 12 or later. Install Claude Code or Codex yourself; midna finds them
              through your login shell.
            </p>
          </div>
          <div class="ctas install-ctas">
            <a class="btn btn-accent" href={DOWNLOAD}>Download for Mac</a>
            <a class="btn btn-ghost" href="/docs/install/">Install guide</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .hero {
    padding: 88px 0 0;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    max-width: 20ch;
  }

  .hero .lede {
    margin-top: 22px;
    max-width: 62ch;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .fineprint {
    margin-top: 16px;
    color: var(--ink-faint);
    font-size: 0.9rem;
  }

  .shot-wrap {
    margin-top: 56px;
  }

  .shot {
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.7);
    background: var(--bg-raised);
  }

  .shot img {
    width: 100%;
    height: auto;
  }

  .hero-shot {
    border-radius: 14px;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  .feature {
    border-top: 1px solid var(--line);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 56px;
    align-items: center;
  }

  @media (max-width: 900px) {
    .feature-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  .feature-head {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 16px 56px;
  }

  @media (max-width: 900px) {
    .feature-head {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .feature-text p {
    color: var(--ink-soft);
  }

  .feature-text p + p {
    margin-top: 14px;
  }

  .feature-shot {
    margin-top: 44px;
  }

  .feature-copy p {
    margin-top: 16px;
    color: var(--ink-soft);
  }

  .feature-copy h2 + p {
    margin-top: 20px;
  }

  .more {
    display: inline-block;
    margin-top: 16px;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .more:hover {
    text-decoration: underline;
  }

  .shell {
    margin: 0;
    padding: 22px 24px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: #0b0d12;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.75;
    color: #d7dbe4;
    white-space: pre-wrap;
    overflow-x: auto;
  }

  .dim {
    color: var(--ink-faint);
  }

  .need {
    color: var(--need);
  }

  .details {
    border-top: 1px solid var(--line);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px 40px;
    margin-top: 36px;
  }

  @media (max-width: 900px) {
    .detail-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .detail-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .detail p {
    margin-top: 8px;
    color: var(--ink-soft);
    font-size: 0.97rem;
  }

  .install {
    border-top: 1px solid var(--line);
  }

  .install-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    gap: 40px;
    align-items: end;
  }

  @media (max-width: 800px) {
    .install-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .install ol {
    margin: 24px 0 0;
    padding-left: 1.3em;
    display: grid;
    gap: 10px;
    color: var(--ink-soft);
  }

  .install ol a {
    color: var(--accent);
  }

  .install-ctas {
    margin-top: 0;
  }
</style>
