---
// "Star on GitHub" with the live star count, fetched in the browser. The
// count stays hidden if GitHub doesn't answer.
import { REPO, REPO_API } from '../site';

interface Props {
  label?: string;
  size?: 'sm' | 'md';
}
const { label = 'Star', size = 'md' } = Astro.props;
---

<a class:list={['star', size]} href={REPO} data-star-api={REPO_API}>
  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
    ><path
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
    ></path></svg
  >
  <span>{label}</span>
  <span class="count" data-star-count hidden></span>
</a>

<style>
  .star {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
    transition: border-color 0.15s ease;
  }
  .star:hover {
    border-color: var(--accent-deep);
  }
  .star.sm {
    padding: 8px 14px;
    font-size: 0.88rem;
  }
  .star.md {
    padding: 14px 22px;
    font-size: 0.98rem;
  }
  .count {
    padding-left: 9px;
    border-left: 1px solid var(--line-strong);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .count::before {
    content: '★ ';
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLElement>('[data-star-api]');
  if (buttons.length) {
    fetch(buttons[0].dataset.starApi!)
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((repo: { stargazers_count: number }) => {
        const n = repo.stargazers_count;
        // No count until there's something to count.
        if (n < 1) return;
        const text = n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n);
        for (const count of document.querySelectorAll<HTMLElement>('[data-star-count]')) {
          count.textContent = text;
          count.hidden = false;
        }
      })
      .catch(() => {});
  }
</script>
